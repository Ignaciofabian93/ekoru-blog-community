generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =====================================================================================
// AUTO-GENERATED — do not edit this file directly.
// Source of truth : prisma/schema.prisma  (root master schema)
// Regenerate      : node scripts/generate-schemas.js
// Migrations      : run ONLY from root — npx prisma migrate dev --schema prisma/schema.prisma
// =====================================================================================

// ─── Enums ───────────────────────────────────────────────────────────────────────

enum BlogType {
  SUSTAINABLE_LIVING
  CONSCIOUS_CONSUMPTION
  ENVIRONMENT_AND_PLANET
  GREEN_ENTREPENEURSHIP
  COMMUNITY_AND_PLATFORM
  EKORU_TIPS
}

enum Language {
  ES
  EN
  FR
  PT
  DE
}

enum BlogReactionType {
  LIKE
  DISLIKE
}

// ─── Models ──────────────────────────────────────────────────────────────────────

model BlogPost {
  id             Int                   @id @default(autoincrement())
  authorId       String
  isPublished    Boolean               @default(false)
  publishedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  blogCategoryId Int
  type           BlogType              @default(SUSTAINABLE_LIVING)
  dislikes       Int                   @default(0)
  likes          Int                   @default(0)
  blogCategory   BlogCategory          @relation(fields: [blogCategoryId], references: [id])
  blogReactions  BlogReaction[]
  translations   BlogPostTranslation[]

  @@index([type])
  @@index([isPublished])
  @@index([publishedAt])
}

model BlogPostTranslation {
  id              Int      @id @default(autoincrement())
  blogPostId      Int
  language        Language
  title           String
  slug            String
  content         String   @db.Text
  excerpt         String?
  metaTitle       String?
  metaDescription String?
  metaKeywords    String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  blogPost        BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@unique([blogPostId, language])
  @@unique([slug, language])
  @@index([slug, language])
  @@index([language, blogPostId])
}

model BlogReaction {
  id         Int              @id @default(autoincrement())
  blogPostId Int
  sellerId   String
  reaction   BlogReactionType
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  blogPost   BlogPost         @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@unique([blogPostId, sellerId])
  @@index([blogPostId])
  @@index([sellerId])
  @@index([reaction])
  @@index([blogPostId, reaction])
}

model BlogCategory {
  id           Int                      @id @default(autoincrement())
  icon         String
  isActive     Boolean                  @default(true)
  sortOrder    Int                      @default(0)
  featuredFrom DateTime?
  featuredUntil DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  posts        BlogPost[]
  translations BlogCategoryTranslation[]

  @@index([isActive, sortOrder])
  @@index([featuredUntil])
}

model BlogCategoryTranslation {
  id              Int          @id @default(autoincrement())
  blogCategoryId  Int
  language        Language
  name            String
  slug            String
  description     String
  href            String?
  metaTitle       String?
  metaDescription String?
  metaKeywords    String[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  blogCategory    BlogCategory @relation(fields: [blogCategoryId], references: [id], onDelete: Cascade)

  @@unique([blogCategoryId, language])
  @@unique([slug, language])
  @@index([slug, language])
  @@index([language, blogCategoryId])
}

model CommunityPost {
  id               Int                @id @default(autoincrement())
  content          String
  images           String[]
  likes            Int                @default(0)
  comments         Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  authorId         String
  title            String
  communityComment CommunityComment[]

  @@index([createdAt])
  @@index([authorId])
}

model CommunityComment {
  id              Int           @id @default(autoincrement())
  communityPostId Int
  sellerId        String
  content         String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  communityPost   CommunityPost @relation(fields: [communityPostId], references: [id])

  @@index([communityPostId])
  @@index([createdAt])
  @@index([sellerId])
}

model CommunityCategory {
  id            Int                           @id @default(autoincrement())
  isActive      Boolean                       @default(true)
  sortOrder     Int                           @default(0)
  featuredFrom  DateTime?
  featuredUntil DateTime?
  createdAt     DateTime                      @default(now())
  updatedAt     DateTime                      @updatedAt
  subcategories CommunitySubCategory[]
  translations  CommunityCategoryTranslation[]

  @@index([isActive, sortOrder])
  @@index([featuredUntil])
}

model CommunityCategoryTranslation {
  id                  Int               @id @default(autoincrement())
  communityCategoryId Int
  language            Language
  category            String
  slug                String
  href                String?
  description         String?
  metaTitle           String?
  metaDescription     String?
  metaKeywords        String[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  communityCategory   CommunityCategory @relation(fields: [communityCategoryId], references: [id], onDelete: Cascade)

  @@unique([communityCategoryId, language])
  @@unique([slug, language])
  @@index([slug, language])
  @@index([language, communityCategoryId])
}

model CommunitySubCategory {
  id                  Int                              @id @default(autoincrement())
  communityCategoryId Int
  isActive            Boolean                          @default(true)
  sortOrder           Int                              @default(0)
  featuredFrom        DateTime?
  featuredUntil       DateTime?
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt
  communityCategory   CommunityCategory                @relation(fields: [communityCategoryId], references: [id])
  translations        CommunitySubCategoryTranslation[]

  @@index([communityCategoryId])
  @@index([isActive, sortOrder])
  @@index([featuredUntil])
}

model CommunitySubCategoryTranslation {
  id                     Int                    @id @default(autoincrement())
  communitySubCategoryId Int
  language               Language
  subCategory            String
  slug                   String
  href                   String?
  description            String?
  metaTitle              String?
  metaDescription        String?
  metaKeywords           String[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  communitySubCategory   CommunitySubCategory   @relation(fields: [communitySubCategoryId], references: [id], onDelete: Cascade)

  @@unique([communitySubCategoryId, language])
  @@unique([slug, language])
  @@index([slug, language])
  @@index([language, communitySubCategoryId])
}

