generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =====================================================================================
// AUTO-GENERATED — do not edit this file directly.
// Source of truth : prisma/schema.prisma  (root master schema)
// Regenerate      : node scripts/generate-schemas.js
// Migrations      : run ONLY from root — npx prisma migrate dev --schema prisma/schema.prisma
// =====================================================================================

// ─── Enums ───────────────────────────────────────────────────────────────────────

enum Language {
  ES
  EN
  FR
  PT
  DE
}

enum BlogReactionType {
  LIKE
  DISLIKE
}

enum CommunityEventStatus {
  SCHEDULED
  CANCELLED
}

enum CommunityEventLocationType {
  IN_PERSON
  ONLINE
  HYBRID
}

enum CommunityReportReason {
  SPAM
  SCAM
  INAPPROPRIATE
  MISLEADING
  OTHER
}

enum CommunityReportStatus {
  OPEN
  DISMISSED
  ACTIONED
}

// ─── Models ──────────────────────────────────────────────────────────────────────

model BlogPost {
  id             Int                   @id @default(autoincrement())
  authorId       String
  isPublished    Boolean               @default(false)
  publishedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  blogCategoryId Int
  dislikes       Int                   @default(0)
  likes          Int                   @default(0)
  // Optional cover image (CDN URL from the R2 image pipeline). A blog has one image or none.
  coverImage     String?
  blogCategory   BlogCategory          @relation(fields: [blogCategoryId], references: [id])
  blogReactions  BlogReaction[]
  translations   BlogPostTranslation[]

  @@index([isPublished])
  @@index([publishedAt])
}

model BlogPostTranslation {
  id              Int      @id @default(autoincrement())
  blogPostId      Int
  language        Language
  title           String
  slug            String
  content         String   @db.Text
  excerpt         String?
  metaTitle       String?
  metaDescription String?
  metaKeywords    String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  blogPost        BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@unique([blogPostId, language])
  @@unique([slug, language])
  @@index([slug, language])
  @@index([language, blogPostId])
}

model BlogReaction {
  id         Int              @id @default(autoincrement())
  blogPostId Int
  sellerId   String
  reaction   BlogReactionType
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  blogPost   BlogPost         @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@unique([blogPostId, sellerId])
  @@index([blogPostId])
  @@index([sellerId])
  @@index([reaction])
  @@index([blogPostId, reaction])
}

model BlogCategory {
  id            Int                       @id @default(autoincrement())
  icon          String
  isActive      Boolean                   @default(true)
  sortOrder     Int                       @default(0)
  featuredFrom  DateTime?
  featuredUntil DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  posts         BlogPost[]
  translations  BlogCategoryTranslation[]

  @@index([isActive, sortOrder])
  @@index([featuredUntil])
}

model BlogCategoryTranslation {
  id              Int          @id @default(autoincrement())
  blogCategoryId  Int
  language        Language
  name            String
  slug            String
  description     String
  href            String?
  metaTitle       String?
  metaDescription String?
  metaKeywords    String[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  blogCategory    BlogCategory @relation(fields: [blogCategoryId], references: [id], onDelete: Cascade)

  @@unique([blogCategoryId, language])
  @@unique([slug, language])
  @@index([slug, language])
  @@index([language, blogCategoryId])
}

model CommunityPost {
  id                     Int                         @id @default(autoincrement())
  title                  String
  content                String
  // Single cover/wallpaper image (CDN URL from the R2 image pipeline).
  coverImage             String?
  // Event schedule: a single date uses startDate only; a range fills both.
  startDate              DateTime?
  endDate                DateTime?
  // Available tickets / places. Null = unlimited.
  capacity               Int?
  likes                  Int                         @default(0)
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  // Admin who created the event from the panel. Null when a business
  // organised it from the app (see organizerId).
  authorId               String?
  // Business (seller) that organises the event. Set for events published from
  // the app; null for events EKORU runs itself from the panel.
  organizerId            String?
  // Where it happens: IN_PERSON needs address + countyId, ONLINE needs
  // onlineUrl, HYBRID needs all three. Validated in ekoru-blog-community.
  locationType           CommunityEventLocationType  @default(IN_PERSON)
  address                String?
  countyId               Int?
  onlineUrl              String?
  // Cancelled events stay for the record; registrants are told (BLC-6).
  status                 CommunityEventStatus        @default(SCHEDULED)
  cancelledAt            DateTime?
  cancellationReason     String?
  // What kind of event it is; drives /community/[category]/[subcategory].
  // Required for new events (checked in ekoru-blog-community); null on
  // events created before categories existed.
  communitySubCategoryId Int?
  communitySubCategory   CommunitySubCategory?       @relation(fields: [communitySubCategoryId], references: [id])
  registrations          CommunityPostRegistration[]
  reports                CommunityPostReport[]

  @@index([createdAt])
  @@index([authorId])
  @@index([organizerId])
  @@index([countyId])
  @@index([communitySubCategoryId])
  @@index([status])
  @@index([startDate])
}

model CommunityPostRegistration {
  id              Int           @id @default(autoincrement())
  communityPostId Int
  name            String
  email           String
  // Optional ekoru profile id, filled in-app when a logged-in user registers.
  sellerId        String?
  createdAt       DateTime      @default(now())
  communityPost   CommunityPost @relation(fields: [communityPostId], references: [id], onDelete: Cascade)

  @@unique([communityPostId, email])
  @@index([communityPostId])
  @@index([sellerId])
}

model CommunityPostReport {
  id              Int                   @id @default(autoincrement())
  communityPostId Int
  reporterId      String
  reason          CommunityReportReason
  details         String?
  status          CommunityReportStatus @default(OPEN)
  // Admin who resolved it (plain id, like BusinessProfile.reviewedById).
  resolvedById    String?
  resolvedAt      DateTime?
  resolutionNote  String?
  createdAt       DateTime              @default(now())
  communityPost   CommunityPost         @relation(fields: [communityPostId], references: [id], onDelete: Cascade)

  @@unique([communityPostId, reporterId])
  @@index([status, createdAt])
}

model CommunityCategory {
  id            Int                            @id @default(autoincrement())
  isActive      Boolean                        @default(true)
  sortOrder     Int                            @default(0)
  featuredFrom  DateTime?
  featuredUntil DateTime?
  createdAt     DateTime                       @default(now())
  updatedAt     DateTime                       @updatedAt
  subcategories CommunitySubCategory[]
  translations  CommunityCategoryTranslation[]

  @@index([isActive, sortOrder])
  @@index([featuredUntil])
}

model CommunityCategoryTranslation {
  id                  Int               @id @default(autoincrement())
  communityCategoryId Int
  language            Language
  category            String
  slug                String
  href                String?
  description         String?
  metaTitle           String?
  metaDescription     String?
  metaKeywords        String[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  communityCategory   CommunityCategory @relation(fields: [communityCategoryId], references: [id], onDelete: Cascade)

  @@unique([communityCategoryId, language])
  @@unique([slug, language])
  @@index([slug, language])
  @@index([language, communityCategoryId])
}

model CommunitySubCategory {
  id                  Int                               @id @default(autoincrement())
  communityCategoryId Int
  isActive            Boolean                           @default(true)
  sortOrder           Int                               @default(0)
  featuredFrom        DateTime?
  featuredUntil       DateTime?
  createdAt           DateTime                          @default(now())
  updatedAt           DateTime                          @updatedAt
  communityCategory   CommunityCategory                 @relation(fields: [communityCategoryId], references: [id])
  translations        CommunitySubCategoryTranslation[]
  communityPosts      CommunityPost[]

  @@index([communityCategoryId])
  @@index([isActive, sortOrder])
  @@index([featuredUntil])
}

model CommunitySubCategoryTranslation {
  id                     Int                  @id @default(autoincrement())
  communitySubCategoryId Int
  language               Language
  subCategory            String
  slug                   String
  href                   String?
  description            String?
  metaTitle              String?
  metaDescription        String?
  metaKeywords           String[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  communitySubCategory   CommunitySubCategory @relation(fields: [communitySubCategoryId], references: [id], onDelete: Cascade)

  @@unique([communitySubCategoryId, language])
  @@unique([slug, language])
  @@index([slug, language])
  @@index([language, communitySubCategoryId])
}

